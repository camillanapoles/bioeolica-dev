FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    python3.11 python3-pip python3-dev \
    calculix-ccx gmsh libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    -e /workspace/instruments/physics-m3 \
    -e /workspace/instruments/cad-cae-platform \
    -e /workspace/instruments/kdi-m3-bridge \
    pytest pytest-cov ruff

WORKDIR /workspace
