#!/usr/bin/env bash
set -euo pipefail

# Auto-detecta o projeto baseado no local do script (funciona de qualquer diretório)
SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

FSM="python3 $PROJECT_ROOT/scripts/agentic/python/fsm_orchestrator.py"
VALIDATOR="python3 $PROJECT_ROOT/scripts/agentic/python/payload_validator.py"
SELFHEAL="$PROJECT_ROOT/scripts/agentic/self-healing.sh"
INDEXCTX="$PROJECT_ROOT/scripts/agentic/index-context.sh"

CMD="${1:-help}"
shift || true

case "$CMD" in
    specify)   $FSM specify ;;
    plan)      $FSM plan ;;
    execute)   "$SELFHEAL" "${1:-next}" ;;
    status)    $FSM status ;;
    gate)      $FSM gate "${1:-SPEC}" ;;
    index)     "$INDEXCTX" ;;
    validate)  $VALIDATOR "$1" ;;
    *)
        echo "Uso: agentic {specify|plan|execute|status|gate|index|validate}"
        ;;
esac
